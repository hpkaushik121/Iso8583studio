{
  "name": "iso8583-studio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build:content && ng serve",
    "build": "npm run build:content && ng build && node tools/postbuild.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:content": "node tools/build-blog-routes.mjs && node tools/build-payments-config.mjs && node tools/build-icons.mjs",
    "blog:images": "node tools/build-blog-routes.mjs --images",
    "check": "node tools/check-links.mjs && node tools/check-tracking.mjs",
    "lint:css": "stylelint \"src/**/*.css\"",
    "serve:dist": "node tools/serve-dist.mjs",
    "media": "node tools/optimize-media.mjs",
    "audit:tracking": "node tools/audit-tracking.mjs",
    "weight": "node tools/measure-weight.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.6",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "three": "^0.186.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "@phosphor-icons/core": "^2.1.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@types/three": "^0.186.0",
    "css-select": "^7.0.0",
    "domutils": "^4.0.2",
    "gray-matter": "^4.0.3",
    "htmlparser2": "^12.0.0",
    "markdown-it": "^15.0.1",
    "prettier": "^3.8.1",
    "puppeteer": "^25.9.0",
    "sharp": "^0.35.5",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.2"
  }
}
