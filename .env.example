# Gemini credentials.
#
# Copy this file to .env and fill in the values. .env is gitignored; this
# template is the tracked one, so add every new property here too — with an
# empty or placeholder value, never a real key.
#
#   cp .env.example .env
#
# Get a key from https://aistudio.google.com/apikey

# The API key requests are authenticated with. Google's own SDKs read this
# name, so a client constructed with no explicit key picks it up.
GEMINI_API_KEY=

# Optional second key. Useful for keeping a separate quota for batch or
# background jobs so they cannot exhaust the interactive one.
GEMINI_API_KEY_SECONDARY=

# Model id, so it can be changed without a code edit.
GEMINI_MODEL=gemini-2.5-flash

# Override only when pointing at a non-default endpoint (a proxy, or a
# regional deployment). Leave empty for the public API.
GEMINI_API_BASE_URL=
